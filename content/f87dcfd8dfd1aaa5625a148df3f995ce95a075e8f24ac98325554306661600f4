[death_penalty]
	#Whether normal deaths remove progress toward each path's next stat point.
	#Spent levels, unspent points, path caps and boss progress are never removed.
	enabled = true
	#Whether a Full Divine death causes persistent Divine Fracture instead of XP loss.
	full_divine_fracture_enabled = true

	[death_penalty.path_xp_loss_by_cap]
		#Fraction of current path XP lost when that path's cap is E.
		#For example, 0.25 means 25% and 1.0 means all current XP.
		# Default: 0.25
		# Range: 0.0 ~ 1.0
		e = 0.25
		#Fraction of current path XP lost when that path's cap is D.
		#For example, 0.25 means 25% and 1.0 means all current XP.
		# Default: 0.25
		# Range: 0.0 ~ 1.0
