[paths]
	physical_enabled = true
	life_enabled = true
	magic_enabled = true

[rank_access]
	#OPEN: every player may reach open_maximum_rank.
	#CLOSED: E is the final rank for every player.
	#ADMIN: each player needs a maximum rank assigned with /ascension access set.
	#RANDOM: each player receives one persistent weighted maximum rank.
	#Allowed Values: OPEN, CLOSED, ADMIN, RANDOM
	mode = "OPEN"
	#Highest rank available to everyone while mode is OPEN.
	#Allowed Values: UNRANKED, E, D, C, B, A, S, CELESTIAL, DIVINE
	open_maximum_rank = "DIVINE"
	#Highest result that may be rolled while mode is RANDOM.
	#Allowed Values: UNRANKED, E, D, C, B, A, S, CELESTIAL, DIVINE
	random_maximum_rank = "DIVINE"
	#Total number of tickets in a random maximum-rank draw.
	#Each rank's chance is its ticket weight divided by this number.
	#Unassigned tickets become E. Tickets above random_maximum_rank also become E.
	#If all rank weights exceed this pool, their relative proportions are preserved automatically.
	# Default: 10000
	# Range: 1 ~ 1000000000000
	maximum_ticket_count = 10000

	[rank_access.random_ticket_weights]
		#Tickets for the E personal maximum inside maximum_ticket_count.
		# Default: 3389
		# Range: 0 ~ 1000000000000
		e = 3389
		#Tickets for the D personal maximum inside maximum_ticket_count.
		# Default: 2500
		# Range: 0 ~ 1000000000000
		d = 2500
		#Tickets for the C personal maximum inside maximum_ticket_count.
		# Default: 1800
		# Range: 0 ~ 1000000000000
		c = 1800
		#Tickets for the B personal maximum inside maximum_ticket_count.
		# Default: 1200
		# Range: 0 ~ 1000000000000
		b = 1200
		#Tickets for the A personal maximum inside maximum_ticket_count.
		# Default: 1000
		# Range: 0 ~ 1000000000000
		a = 1000
		#Tickets for the S personal maximum inside maximum_ticket_count.
		# Default: 100
		# Range: 0 ~ 1000000000000
		s = 100
		#Tickets for the CELESTIAL personal maximum inside maximum_ticket_count.
		# Default: 10
		# Range: 0 ~ 1000000000000
		celestial = 10
		#Tickets for the DIVINE personal maximum inside maximum_ticket_count.
		# Default: 1
		# Range: 0 ~ 1000000000000
		divine = 1

