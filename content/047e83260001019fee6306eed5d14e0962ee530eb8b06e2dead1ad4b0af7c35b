#Show occasional seated face-rub variation when leaving bed.
reluctantWake = true
#Animate successful ground-item pickups; movement and inventory rules stay unchanged.
pickupAnimation = true
#Animate successful item drops locally and on visible players; item rules are unchanged.
dropAnimation = true
#Animate bed entry and exit for your camera and visible players. Does not change sleeping rules.
bedAnimation = true
#Enable the wake-up intro. Set false to disable both first-entry playback and previews.
#Disabling during playback ends it. Skipped first-entry intros remain marked as seen.
enabled = true
#Keep normal eye height and use a single fade without camera movement or repeated blinks.
reducedMotion = false
#Temporarily suppress First-person Model's body during the wake-up intro to avoid camera clipping.
#Only applies when First-person Model is installed; its saved settings are never changed.
firstPersonCompatibility = true

[compatibility]
	#Optional mod IDs that should own all player poses and first-person presentation when installed. Leave empty for selective per-action control. This does not inspect those mods' internal enabled state.
	additionalAnimationOwners = []
	#Enable Punchy choices in per-action priority. Automatic uses a documented overlap profile for first person; it cannot inspect internal settings or resource-pack mappings. Third-person RPG poses remain available.
	punchyHandoff = true
	#Enable Better Combat choices in per-action priority. Automatic yields overlapping combat actions during attacks; unrelated RPG actions remain enabled.
	betterCombatHandoff = true
	#Yield player presentation while Saros owns that player as an active ragdoll. Does not alter physics or revive behaviour.
	sarosHandoff = true
	#Yield player presentation while Ragdollified hides that player. Corpses belonging to an old player entity do not suppress the respawned player.
	ragdollifiedHandoff = true
	#Yield RPG player poses while Carry On reports a carried block or entity. Does not change carrying mechanics.
	carryOnHandoff = true
	#Keep Corpse's dummy player free of live-player gestures and inventory panels; respawned players remain animated.
	corpseHandoff = true

