	["Mob Settings"."Nightlord Settings"]
		#Multiplies the health of the Nightlord.
		#At 1.0 that is 225 per phase; 450 total.
		#Minecraft caps max health at 1024 (more with mods like AttributeFix); above that he gets the cap.
		# Default: 1.0
		# Range: 0.01 ~ 1000.0
		"Nightlord Health Multiplier" = 1.0
		#Multiplies the damage dealt by the Nightlord, attacks and effects alike.
		# Default: 1.14
		# Range: 0.0 ~ 1000.0
		"Nightlord Damage Multiplier" = 1.0
		#Multiplies the armor of the Nightlord. At 1.0 that is 20.
		# Default: 0.5
		# Range: 0.0 ~ 1000.0
		"Nightlord Armor Multiplier" = 1.0
		#How many attacks the Nightlord chains before he takes a breather.
		#There is also a chance per attack to cut the chain short, so the average is below this number.
		# Default: 3
		# Range: 1 ~ 20
		"Nightlord Attacks Per Combo" = 3
		#Multiplies the magic damage the Nightlord takes (vanilla magic, and every damage type
		#in the tag souls_like_bosses:magic_damage, e.g. Iron's Spells 'n Spellbooks). 1.0 changes nothing, 0.5 halves it.
		# Default: 1.0
		# Range: 0.0 ~ 10.0
		"Nightlord Magic Damage Taken Multiplier" = 1.0
		#The most damage a single hit can deal to the Nightlord, before armor. 0 means no limit.
		#Also the size of his damage budget (see DPS Cap). Keeps single huge hits from skipping the fight.
		# Default: 20.0
		# Range: 0.0 ~ 1000000.0
		"Nightlord Max Damage Per Hit" = 20.0
		#Every hit fills a budget of Max Damage Per Hit; it empties by this much per second.
		#Hits beyond a full budget deal almost nothing, so bursts and multi-hit spells cannot shred him. 0 means no limit.
		# Default: 14.0
		# Range: 0.0 ~ 1000000.0
		"Nightlord DPS Cap" = 14.0
		#An attacker farther away than this many blocks deals less damage, none at 1.5 times the distance.
		#Stops sniping him from outside the arena. 0 means no limit.
		# Default: 15.0
		# Range: 0.0 ~ 1000000.0
		"Nightlord Range Cap" = 15.0
		#Each hit of the Nightlord also deals this share of the target's max health (0.05 = 5 %),
		#at most as much again as the hit itself. Keeps him dangerous for targets with a lot of health. 0 turns it off.
		# Default: 0.05
		# Range: 0.0 ~ 1.0
		"Nightlord Max Health Damage" = 0.05

