#How completed advancements turn into points.
[points]
	#Completed advancements needed for 1 point.
	#1 = a point for every advancement, 3 = a point for every 3rd advancement, and so on.
	#Advancements completed toward the next point carry over.
	# Default: 1
	# Range: 1 ~ 1000
	advancements_per_point = 1
	#Completed advancements that give no points before counting starts.
	#0 = every advancement counts, 5 = the first 5 advancements give nothing.
	#Advancements completed before the mod was installed count toward this too.
	# Default: 0
	# Range: 0 ~ 10000
	skipped_advancements = 0

#Maximum level of each buff.
#-1 = no limit, 0 = disabled (never offered; existing levels are refunded as points on join).
#Lowering a cap refunds the levels above it the next time each player joins.
[max_levels]
	#Vitality: +1 max heart per level (default: no limit)
	# Default: -1
	# Range: -1 ~ 1000000
	max_health = -1
	#Strength: +0.5 attack damage per level (default: no limit)
	# Default: -1
	# Range: -1 ~ 1000000
	attack_damage = -1
	#Long Arms: +1 block/entity reach per level
	# Default: 5
	# Range: -1 ~ 1000000
	reach = 5
	#Haste: +10% mining speed per level
	# Default: 10
	# Range: -1 ~ 1000000
	mining_speed = 10
	#Swiftness: +10% movement speed per level
	# Default: 5
	# Range: -1 ~ 1000000
	movement_speed = 5
	#Feather Fall: +1 safe fall block per level (default: no limit)
	# Default: -1
	# Range: -1 ~ 1000000
	safe_fall = -1
	#Toughness: +1 armor per level
	# Default: 10
	# Range: -1 ~ 1000000
	armor = 10
	#Quick Hands: +5% attack speed per level
	# Default: 10
	# Range: -1 ~ 1000000
	attack_speed = 10
	#Steadfast: +10% knockback resistance per level
	# Default: 10
