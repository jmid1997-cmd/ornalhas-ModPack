[general]
	#Multiplier applied to every perk's XP-level cost, on top of the per-perk
	#costs below (1.0 = per-perk cost as-is)
	# Default: 1.0
	# Range: 0.0 ~ 100.0
	costMultiplier = 1.0
	#Fraction of the XP levels spent on perks that a respec (/perks reset)
	#refunds - 0.8 = 80%, 0.0 = nothing
	# Default: 0.8
	# Range: 0.0 ~ 1.0
	respecRefundFraction = 0.8
	#Allow non-op players to run /perks reset on themselves
	allowSelfRespec = true

