#The effects that deal damage have five levels, from I to V. Level III uses the values set in each section. The effects that deal no damage have a single level.
[levels]
	#Share of the level III damage that each level above it adds and each level below it takes away. With 0.25, level I deals 50% of the damage, level II 75%, level IV 125% and level V 150%.
	# Default: 0.25
	# Range: 0.0 ~ 1.0
	damagePerLevel = 0.25
	#When turned on, the damage of a mob's ability on a player follows the world difficulty, like the hits of vanilla mobs. On Easy, it is halved and one point is added. On Hard, it is one and a half times higher. It applies to the damage types in #zens_effectlib:scales_with_difficulty.
	scaleWithDifficulty = false

#Some mods make their mobs cast one ability at a time. This section sets the pause between two of those abilities.
[pacing]
	#Pause between the end of one ability and the start of the next one, for the mods that do not choose their own. This time is counted in seconds.
	# Default: 3.0
	# Range: 0.0 ~ 60.0
	defaultGapSeconds = 3.0

#Once in its life, when its health falls below a set share, the bearer flies into a rage.
[berserker]
	#When turned off, the effect can no longer be given by commands, spawn eggs or other mods, and the mobs that already have it lose it.
	enabled = true
	#The rage starts when health falls below this share of the maximum health.
	# Default: 0.8
	# Range: 0.01 ~ 1.0
	healthThreshold = 0.8
	#Movement speed added during the rage. With 0.4, the bearer moves 40% faster.
	# Default: 0.4
	# Range: 0.0 ~ 10.0
	movementSpeedBonus = 0.4
	#Attack speed added during the rage. With 0.5, the bearer attacks 50% faster.
	# Default: 0.5
	# Range: 0.0 ~ 10.0
	attackSpeedBonus = 0.5
	#The damage dealt during the rage is multiplied by this value.
	# Default: 1.35
	# Range: 1.0 ~ 20.0
	damageMultiplier = 1.35
	#Share of armor and Protection that the damage ignores. At 0, it ignores nothing. At 1, it ignores everything.
	# Default: 0.3
	# Range: 0.0 ~ 1.0
	armorPiercing = 0.3
	#Knockback resistance added during the rage.
	# Default: 0.5
	# Range: 0.0 ~ 1.0
	knockbackResistanceBonus = 0.5

#Light damage every second for a short time, which goes through armor.
[bleeding]
	#When turned off, the effect can no longer be given by commands, spawn eggs or other mods, and the mobs that already have it lose it.
	enabled = true
	#Damage dealt every second. This amount is counted in half-hearts, so 2 means one heart, before armor reduces it.
	# Default: 0.5
	# Range: 0.0 ~ 1000.0
	damagePerSecond = 0.5
	#Longest possible bleeding, whatever duration it is given. This time is counted in seconds.
	# Default: 10.0
	# Range: 0.05 ~ 600.0
	durationSeconds = 10.0

#The bearer teleports behind a target that is far away.
[blink]
	#When turned off, the effect can no longer be given by commands, spawn eggs or other mods, and the mobs that already have it lose it.
	enabled = true
	#A visible target within this distance can be reached. This distance is counted in blocks.
	# Default: 16.0
	# Range: 1.0 ~ 128.0
	detectionRange = 16.0
	#A target closer than this distance is left alone, because the bearer is already next to it.
	# Default: 5.0
	# Range: 0.0 ~ 64.0
	minDistance = 5.0
	#The bearer lands this many blocks behind its target.
	# Default: 2.0
	# Range: 1.0 ~ 8.0
	behindDistance = 2.0
	#Time to wait after a use before the next one. At 0, there is no wait. This time is counted in seconds.
	# Default: 8.0
	# Range: 0.0 ~ 3600.0
	cooldownSeconds = 8.0

#After a long charge, the bearer releases a blast that throws everything around it back.
[celestial_repulsion]
	#When turned off, the effect can no longer be given by commands, spawn eggs or other mods, and the mobs that already have it lose it.
	enabled = true
	#A visible player within this distance starts the charge. This distance is counted in blocks.
	# Default: 12.0
	# Range: 1.0 ~ 128.0
	detectionRange = 12.0
	#How long the charge lasts. This time is counted in seconds.
	# Default: 10.0
	# Range: 0.05 ~ 120.0
	chargeSeconds = 10.0
	#How far the blast reaches. This distance is counted in blocks.
	# Default: 12.0
	# Range: 1.0 ~ 128.0
	radius = 12.0
	#Damage dealt to the living creatures that the blast throws back. This amount is counted in half-hearts, so 2 means one heart, before armor reduces it.
	# Default: 5.0
	# Range: 0.0 ~ 1000.0
	damage = 5.0
	#Share of armor and Protection that the damage ignores. At 0, it ignores nothing. At 1, it ignores everything.
	# Default: 0.5
	# Range: 0.0 ~ 1.0
	armorPiercing = 0.5
	#Horizontal speed given to what stands right next to the bearer. With 3.5, it is flung about 90 blocks away.
	# Default: 3.5
	# Range: 0.0 ~ 3.9
	pushNear = 3.5
	#Horizontal speed given at the edge of the blast. With 2.0, it is flung about 50 blocks away.
	# Default: 2.0
	# Range: 0.0 ~ 3.9
	pushFar = 2.0
	#Upward speed given right next to the bearer. With 1.3, it is lifted about 9 blocks high.
	# Default: 1.3
	# Range: 0.0 ~ 3.9
	liftNear = 1.3
	#Upward speed given at the edge of the blast.
	# Default: 1.0
	# Range: 0.0 ~ 3.9
	liftFar = 1.0
	#How long the blast keeps pushing what it threw. This time is counted in seconds.
	# Default: 1.0
	# Range: 0.05 ~ 10.0
	pushSeconds = 1.0
	#Time to wait after a use before the next one. At 0, there is no wait. This time is counted in seconds.
	# Default: 10.0
	# Range: 0.0 ~ 3600.0
	cooldownSeconds = 10.0
	#Even the heaviest creatures keep this share of the push, whatever their knockback resistance.
	# Default: 0.25
	# Range: 0.0 ~ 1.0
	minPushKept = 0.25
	#Projectiles are sent back at least this fast, in blocks per tick.
	# Default: 1.5
	# Range: 0.0 ~ 10.0
	projectileSpeed = 1.5

