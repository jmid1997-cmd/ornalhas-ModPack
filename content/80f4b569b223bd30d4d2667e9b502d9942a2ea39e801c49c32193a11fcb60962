	# Range: 0.0 ~ 60.0
	itemCooldownSeconds = 2.0
	#After being disarmed, a creature cannot be disarmed again for this time, whoever hits it. This time is counted in seconds.
	# Default: 10.0
	# Range: 0.0 ~ 600.0
	protectionSeconds = 10.0

