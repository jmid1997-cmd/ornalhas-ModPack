[progression]
	#Multiplies all XP from kills.
	# Default: 1.0
	# Range: 0.0 ~ 100.0
	xpMultiplier = 1.0
	#Maximum player level.
	# Default: 300
	# Range: 1 ~ 1000
	maxLevel = 300
	#What a player loses on death. NONE keeps everything.
	#Allowed Values: NONE, LOSE_10_PERCENT
	deathPenalty = "NONE"
	#XP multiplier for mobs that came from a spawner.
	# Default: 0.25
	# Range: 0.0 ~ 1.0
	spawnerXpMultiplier = 0.25
	#Share of the XP for players who helped (damaged the mob in the last 10 s, within 32 blocks).
	# Default: 0.5
	# Range: 0.0 ~ 1.0
	assistShare = 0.5
	#Distance in blocks at which mob levels appear, before Perception.
	# Default: 12
	# Range: 4 ~ 64
	nameplateRange = 12

[world]
	#Rifts open near players every few in-game days.
	riftsEnabled = true
	#Minimum in-game days between rifts for a player.
	# Default: 2
	# Range: 1 ~ 100
	riftDaysMin = 2
	#Maximum in-game days between rifts for a player.
	# Default: 4
	# Range: 1 ~ 100
	riftDaysMax = 4

